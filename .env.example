# Copy to .env and fill in. .env is gitignored; never commit real secrets.

DATABASE_URL=postgresql:///sentinelmesh

# Comma-separated entries of name:scopes:secret. Scopes are joined with '+'
# and must be drawn from {read, write}. Secrets must be at least 16 characters;
# generate them with `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
SENTINELMESH_API_KEYS=ingest-agent:write:REPLACE_ME_WITH_A_REAL_SECRET,soc-analyst:read:REPLACE_ME_TOO_1234
